    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
